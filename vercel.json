{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/paste(.*)", "destination": { "service": "backend" } },
    { "source": "/upload", "destination": { "service": "backend" } },
    { "source": "/download(.*)", "destination": { "service": "backend" } },
    { "source": "/links(.*)", "destination": { "service": "backend" } },
    { "source": "/internal/cleanup", "destination": { "service": "backend" } },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}